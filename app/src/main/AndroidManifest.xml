<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        This app held no INTERNET permission for its first two versions, on the grounds
        that motion data describes where the phone has been and how it is carried, and the
        simplest way to promise it goes nowhere is to make it impossible.

        Reporting a stolen phone's position to a Telegram group needs the network, so that
        promise no longer holds and this comment says so rather than being left as a lie.
        What is narrower is the traffic: nothing is sent unless the location report is
        switched on, and the only thing ever sent is a position after a theft. Motion data
        still goes nowhere.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- The second channel, and the one that survives a data outage. -->
    <uses-permission android:name="android.permission.SEND_SMS" />

    <!--
        Background location needs "Allow all the time", granted by hand. Without it the
        position is only readable while the app is in front, which is never the case during
        a theft.
    -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- The watch has to survive the screen going on and off and the app not being in
         front, which on Android means a foreground service with a visible notification. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!--
        Asked for, not assumed. Without it several OEM skins kill the foreground service
        anyway, and a protection that has quietly stopped is worse than one that is
        honestly off.
    -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!--
        Shizuku. Closing the power menu means writing two global settings, and that needs
        shell UID, which no ordinary app has. Not required for anything else: without it
        the screen still locks and the alarm still sounds.
    -->
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />
    <!--
        A full-screen intent is the sanctioned way to put a screen up from the background;
        a plain startActivity is silently dropped on Android 10 and above.
    -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!--
        Not required, but on several skins it is what actually lets the alert appear.
        Asked for from the app, never assumed.
    -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <uses-feature android:name="android.hardware.sensor.accelerometer" android:required="true" />
    <!-- Not required: the detector can fall back to jerk alone, worse but working. -->
    <uses-feature android:name="android.hardware.sensor.gyroscope" android:required="false" />

    <application
        android:name=".SonderAssistApp"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.SonderAssist">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:theme="@style/Theme.SonderAssist">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!--
                What a long press on the quick settings tile opens. Declaring it is the
                whole implementation; Android does the routing.
            -->
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
            </intent-filter>
        </activity>

        <!--
            The quick settings tile. Arming and disarming is the thing done often, and it
            is done in the moments where opening an app is inconvenient — getting on a
            train, handing the phone to someone.
        -->
        <service
            android:name=".sensor.WatchTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>

        <!--
            What the Shizuku app binds to. It has to be exported for that, and it is
            guarded by a permission only the system holds.
        -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <!--
            specialUse rather than a stock type: none of the defined foreground service
            types describes "watch the accelerometer for a theft". Declaring one that does
            not fit would be a lie to the platform.
        -->
        <service
            android:name=".sensor.WatchService"
            android:exported="false"
            android:foregroundServiceType="specialUse|location">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Detects the phone being taken from the user's hand and locks the screen." />
        </service>

        <!--
            Device Admin, declaring force-lock and nothing else.

            Not an accessibility service: those are unreliable on several OEM skins, and a
            protection that stops working after a reboot without saying so is worse than
            none. force-lock survived Google's device admin deprecation because enterprise
            management depends on it, and that same dependency is why an OEM cannot
            quietly break it.
        -->
        <receiver
            android:name=".security.AdminReceiver"
            android:exported="true"
            android:label="@string/admin_label"
            android:description="@string/admin_description"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!--
            The screen shown over the keyguard after a lock. excludeFromRecents and
            noHistory so it cannot be found again by someone paging through recents, and
            singleTask so a second detection reuses the one already showing.
        -->
        <activity
            android:name=".ui.AlertActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:launchMode="singleTask"
            android:showOnLockScreen="true"
            android:theme="@style/Theme.SonderAssist" />

        <!--
            RECEIVE_BOOT_COMPLETED was declared from the first commit with nothing behind
            it, so the app was dead after every reboot until someone opened it.
        -->
        <receiver
            android:name=".sensor.BootReceiver"
            android:exported="true"
            android:directBootAware="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>

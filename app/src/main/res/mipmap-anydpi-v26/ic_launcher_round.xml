<?xml version="1.0" encoding="utf-8"?>
<!--
    The mark, on black. The foreground is a mipmap rather than a vector because the
    artwork is strokes at angles that a hand-written path would only approximate, and it
    sits inside the 72dp safe zone so no launcher mask can clip it.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
